# Plantilla de variables de entorno para hosting.
# Copiala como .env (o configuralas en el panel del proveedor) y
# NUNCA subas el archivo .env real al repositorio.

# Activa el modo hosting. En este modo:
#  - se exige iniciar sesion en cada navegador (no se usa la huella del equipo)
#  - las cookies de sesion se marcan como seguras (requiere HTTPS)
HOSTED_MODE=1

# Secreto para firmar las cookies de sesion.
# Generalo con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Credenciales del administrador inicial.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Conexion a PostgreSQL. El proveedor te da esta cadena.
# Render, por ejemplo: postgresql://usuario:clave@dpg-xxxx/ventaystock
# (si empieza con postgres:// el propio sistema la normaliza)
DATABASE_URL=

# Ruta del volumen persistente (opcional). Si no se define, se usa ./data
# dentro del proyecto, que en la mayoria de los hostings es efimero.
# APP_DATA_DIR=/var/data

# Carpeta de respaldos (opcional). Debe estar en almacenamiento persistente.
# BACKUP_DIR=/var/data/respaldos_nube

# Lo define el hosting automaticamente.
PORT=8000
